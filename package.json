{
  "name": "takistir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "check": "node --check backend/src/index.js && npm test && npm run build && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test backend/test/*.test.js frontend/src/manager/model.test.js frontend/src/cart/*.test.js frontend/src/auth/*.test.js"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.10"
  }
}
