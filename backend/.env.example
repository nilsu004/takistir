HOST=127.0.0.1
PORT=3001

# PostgreSQL connection. Leave unset to let the API start its own local
# PostgreSQL 17 in backend/data/postgres (no Docker needed).
# With the team Docker database (docker compose up -d db):
# DATABASE_URL=postgres://takistir:takistir@127.0.0.1:5432/takistir

# Optional folder for the built-in local PostgreSQL (used only without DATABASE_URL)
# LOCAL_PG_DIR=./data/postgres
